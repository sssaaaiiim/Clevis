FRONTEND_ORIGIN=http://localhost:5173
BROWSER_HEADLESS=true
MAX_STEPS=30
MAX_SECONDS=300
MAX_TOKENS=200000
USE_FAKES=true
LOG_LEVEL=INFO
BROWSER_DRIVER=fake
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
DEVICE_SCALE_FACTOR=1
NAV_TIMEOUT_MS=20000
ACTION_TIMEOUT_MS=8000
MAX_OBSERVED_ELEMENTS=150
MAX_OBSERVED_TEXT_CHARS=3000
SLOW_MO_MS=0

# Task 4: choose actual model IDs from the OpenRouter catalog.
LLM_PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_PRIMARY=deepseek/deepseek-v4-flash
LLM_MODEL_FALLBACK=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=800
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=2
MAX_COST_USD=0.50
MAX_HISTORY_STEPS_IN_PROMPT=8

# In-memory live preview
SCREENCAST_FORMAT=jpeg
SCREENCAST_QUALITY=85
SCREENCAST_MAX_FPS=15
SCREENCAST_EVERY_NTH_FRAME=1
SCREENCAST_FALLBACK_FPS=2
PREVIEW_IDLE_RESEND_S=1.0
PREVIEW_CLIENT_QUEUE=2
PREVIEW_AUTH_TIMEOUT_S=5
PREVIEW_RETAIN_AFTER_END_S=30

# Human control: independent of the agent's paused time budget.
TAKEOVER_MAX_SECONDS=600
INPUT_MAX_MESSAGES_PER_SECOND=200
INPUT_MAX_TEXT_LENGTH=2000
INPUT_MAX_MESSAGE_BYTES=8192
INPUT_IDLE_TIMEOUT_S=120
MAX_HANDOFFS=3

# Optional observation/action adapter; never needed for Playwright or fakes.
AGENT_DRIVER=playwright
PINCHTAB_URL=http://127.0.0.1:9867
PINCHTAB_TOKEN=
PINCHTAB_TIMEOUT_S=8

# Per-process admission limit; paused and cleaning-up runs retain their slot.
MAX_CONCURRENT_RUNS=3
